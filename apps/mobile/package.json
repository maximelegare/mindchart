  "scripts": {
    "android": "expo run:android",
    "build:web": "expo export --platform web",
    "build:icons": "tsx scripts/build-icons.mts",
    "theme:generate": "tsx scripts/generate-theme.ts",
    "dev": "yarn expo start -c --dev-client --lan --clear",
    "dev:android": "expo start -c --android",
    "expo-check": "yarn expo install --check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "fbtee-collect": "yarn fbtee collect --disable-babel-config --src app --src features --src components --src pages --src lib --src hooks --src api --src context --src utils --src seed",
    "fbtee-prepare": "yarn fbtee prepare-translations --source-strings source_strings.json --output-dir ./features/translations/data --locales fr-CA ",
    "fbtee-translate": "yarn fbtee translate --source-strings source_strings.json --translations features/translations/data/fr-CA.json --output-dir features/translations/runtime",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "lint": "eslint --cache . && tsc",
    "add:icons": "npx @sly-cli/sly add",
    "setup:skia": "node ./node_modules/@shopify/react-native-skia/scripts/install-skia.mjs",
    "bump:patch": "yarn version:patch",
    "bump:minor": "yarn version:minor",
    "bump:major": "yarn version:major"
  },
  "trustedDependencies": [
    "@shopify/react-native-skia",
    "tailwindcss",
    "nativewind"
  ],
  "op-sqlite": {
    "fts5": true,
    "sqlcipher": true
