import * as path from 'node:path';
import fsExtra from 'fs-extra';
import { glob } from 'glob';
import { parse } from 'node-html-parser';

// --- Configuration ---
const cwd = process.cwd();
const inputDir = path.join(cwd, 'svg'); // Where Sly puts your SVGs
const typeDir = path.join(cwd, 'components', 'ui', 'icons');
const outputFilename = 'icon-registry.ts';

/**
 * Normalizes file paths to valid icon names
 */
function iconName(file: string) {
  return file.replace(/\.svg$/, '').replace(/\\/g, '/');
}

/**
 * Writes file only if content has changed to prevent unnecessary re-builds
 */
async function writeIfChanged(filepath: string, newContent: string) {
  const currentContent = await fsExtra.readFile(filepath, 'utf8').catch(() => '');
  if (currentContent === newContent) return false;
  await fsExtra.ensureDir(path.dirname(filepath));
  await fsExtra.writeFile(filepath, newContent, 'utf8');
  return true;
}

async function run() {
  console.log('Generating Icon Registry...');

  // 1. Find all SVG files
  const files = glob
    .sync('**/*.svg', { cwd: inputDir })
    .sort((a, b) => a.localeCompare(b));

  if (files.length === 0) {
    console.error(`❌ No SVG files found in ${inputDir}`);
    return;
  }

  // 2. Extract data from each SVG
  const iconData = await Promise.all(
    files.map(async (file) => {
      const input = await fsExtra.readFile(path.join(inputDir, file), 'utf8');
      const root = parse(input);
      const svg = root.querySelector('svg');
      
      if (!svg) throw new Error(`No SVG element found in ${file}`);

      // Remove stroke attributes from the SVG tag itself and all children
      const elementsWithStroke = svg.querySelectorAll('[stroke]');
      // Also check the root <svg> tag for a stroke
      if (svg.getAttribute('stroke')) {
        svg.removeAttribute('stroke');
      }
      
      elementsWithStroke.forEach((el) => {
        el.removeAttribute('stroke');
      });

      return {
        name: iconName(file),
        viewBox: svg.getAttribute('viewBox') || '0 0 24 24',
        // Clean up content: remove comments and extra whitespace
        content: svg.innerHTML.trim().replace(/\s+/g, ' '),
      };
    })
  );

  // 3. Generate the TypeScript content
  const typeOutputContent = `// This file is generated by build:icons. Do not edit manually.

export type IconName = 
\t| ${iconData.map((id) => `"${id.name}"`).join('\n\t| ')};

export const ICON_METADATA: Record<IconName, { viewBox: string; content: string }> = {
${iconData
  .map(
    (icon) => `  "${icon.name}": { 
    viewBox: "${icon.viewBox}", 
    content: \`${icon.content}\` 
  },`
  )
  .join('\n')}
};
`;

  // 4. Write to disk
  const outputPath = path.join(typeDir, outputFilename);
  const changed = await writeIfChanged(outputPath, typeOutputContent);

  if (changed) {
    console.log(`✅ Generated ${files.length} icons to ${path.relative(cwd, outputPath)}`);
  } else {
    console.log('✨ Icons are already up to date.');
  }
}

run().catch((err) => {
  console.error('💥 Error generating icons:', err);
  process.exit(1);
});