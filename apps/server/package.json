{
  "name": "server",
  "version": "0.1.0",
  "description": "MindChart Server",
  "author": "Maxime Legare",
  "license": "SEE LICENSE IN LICENSE",
  "repository": "maximelegare/mindchart",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "build": "tsc && tsup",
    "dev": "node --import=tsx --watch src/index.ts",
    "prod": "node dist/index.js",
    "check": "biome check --write",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "lint": "eslint --cache . && tsc"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7.3.4",
    "@repo/constants": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/openai": "workspace:*",
    "@repo/zod-schemas": "workspace:*",
    "cors": "2.8.5",
    "dotenv": "17.2.1",
    "express": "5.1.0",
    "express-rate-limit": "8.0.1",
    "helmet": "8.1.0",
    "http-status-codes": "2.3.0",
    "jsonrepair": "^3.13.2",
    "multer": "^2.0.2",
    "pino": "9.9.0",
    "pino-http": "10.5.0",
    "swagger-ui-express": "5.0.1",
    "zod": "^3.25.74"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.4",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/multer": "^2.0.0",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "^9.34.0",
    "pino-pretty": "13.1.1",
    "supertest": "7.1.4",
    "tsup": "8.5.0",
    "tsx": "4.20.4",
    "typescript": "5.9.2",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.4"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "outDir": "dist",
    "format": [
      "esm",
      "cjs"
    ],
    "target": "es2020",
    "sourcemap": true,
    "clean": true,
    "dts": true,
    "splitting": false,
    "skipNodeModulesBundle": true
  }
}
