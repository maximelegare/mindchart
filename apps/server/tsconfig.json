{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@repo/zod-schemas": ["../../packages/zod-schemas/server.ts"],
      "@repo/zod-schemas/*": ["../../packages/zod-schemas/*"],
      "@repo/constants": ["../../packages/constants/index.ts"],
      "@repo/constants/*": ["../../packages/constants/*"],
      "@repo/ai/openai": ["../../packages/ai/openai/index.ts"],
      "@repo/ai/openai/*": ["../../packages/ai/openai/*"]
    },
    "moduleResolution": "bundler",
    "outDir": "dist",
    "importsNotUsedAsValues": "remove",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vitest/globals"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
