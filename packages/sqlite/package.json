{
  "type": "module",
  "dependencies": {
    "@op-engineering/op-sqlite": "^15.2.3",
    "@repo/zod-schemas": "workspace:*",
    "buffer": "^6.0.3",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.43.1",
    "expo-file-system": "^19.0.17"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "eslint": "^9.34.0",
    "typescript": "5.9.2",
    "@types/node": "^22.15.3",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "@types/react-native": "^0.73.0"
  },
  "exports": {
    ".": "./index.ts"
  },
  "private": true,
  "scripts": {
    "check-types": "tsc --noEmit",
    "exports:generate": "node ./scripts/generate-index.mjs",
    "lint": "eslint . --max-warnings 0",
    "db:generate": "drizzle-kit generate",
    "db:pull-from-computer": "adb shell run-as com.mindchart.dev.app sh -c 'cat > /data/user/0/com.mindchart.dev.app/files/databases/mindchart.db' < mindchart.db",
    "db:push-to-computer": "adb shell run-as com.mindchart.dev.app cat files/databases/mindchart.db > mindchart.db"
  },
  "version": "0.0.0",
  "name": "@repo/sqlite"
}
